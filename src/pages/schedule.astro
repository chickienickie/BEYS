
---
import Layout from '../layouts/Layout.astro';

const registrationUrl =
  'https://login.stacksports.com/login?client_id=612b0399b1854a002e427f78&redirect_uri=https://core-api.bluesombrero.com/login/redirect/portal/6317&app_name=Bald+Eagle+Youth+Soccer&portalid=6317&instancekey=sports';
---

<Layout title="Game Schedules | Bald Eagle Youth Soccer">

  <!-- Page Hero -->
  <section class="program-hero">
    <div class="modern-wrap">
      <p class="eyebrow">
        Bald Eagle Youth Soccer • Spring 2027
      </p>

      <h1>Game Schedules.</h1>

      <p>
        Your home for recreational and travel soccer schedules.
      </p>
    </div>
  </section>

  <!-- Coming Soon -->
  <section class="modern-section modern-wrap">

    <div class="modern-heading coming-soon">

      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="52"
        height="52"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="3" y="5" width="18" height="16" rx="2"/>
        <path d="M16 3v4M8 3v4M3 10h18"/>
        <path d="M8 14h2M14 14h2M8 17h2"/>
      </svg>

      <p class="eyebrow">Spring 2027 Season</p>

      <h2>Coming Soon!</h2>

      <p>
        We're getting ready for another great season of soccer!
        Game schedules will be posted here once they are finalized.
        Check back for updates as we get closer to the season.
      </p>

    </div>

    <div class="two-grid">

      <!-- Recreational Soccer -->
      <article class="modern-card">

        <div class="modern-card-head">
          <p class="eyebrow">Learn • Play • Grow</p>
          <h3>Recreational Soccer</h3>
        </div>

        <div class="modern-card-body">

          <div class="modern-schedule">
            <small>Practice Days</small>
            <strong>Tuesday &amp; Thursday</strong>

            <small>Game Days</small>
            <strong>Saturday*</strong>
          </div>

          <p class="schedule-status">
            Spring schedule coming soon.
          </p>

          <a href="/recreational">
            Program Information →
          </a>

        </div>
      </article>

      <!-- Travel Soccer -->
      <article class="modern-card">

        <div class="modern-card-head">
          <p class="eyebrow">
            Develop • Challenge • Compete
          </p>
          <h3>Travel Soccer</h3>
        </div>

        <div class="modern-card-body">

          <div class="modern-schedule">
            <small>Practice Days</small>
            <strong>Monday &amp; Wednesday</strong>

            <small>Game Days</small>
            <strong>Sunday</strong>
          </div>

          <p class="schedule-status">
            Spring schedule coming soon.
          </p>

          <a href="/travel">
            Program Information →
          </a>

        </div>
      </article>

    </div>

    <p class="fine-print schedule-note">
      *U6 recreational games are held on Thursday evenings.
      All schedules are subject to change.
    </p>

  </section>

  <!-- Registration CTA -->
  <section class="modern-section gold-section">
    <div class="modern-wrap modern-heading">

      <p class="eyebrow">Join the BEYS Family</p>

      <h2>See You on the Field!</h2>

      <p data-schedule-opening>
        Spring 2027 registration opens January 1.
      </p>

      <a
        class="modern-btn navy"
        href={registrationUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Register Now →
      </a>

    </div>
  </section>

</Layout>

<style>
  .coming-soon {
    max-width: 650px;
    margin: 0 auto 40px;
    text-align: center;
  }

  .coming-soon svg {
    color: #002a43;
    margin-bottom: 12px;
  }

  .coming-soon .eyebrow {
    color: #52636e;
  }

  .coming-soon h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 10px 0 15px;
  }

  .coming-soon p {
    line-height: 1.7;
  }

  .modern-card-head p {
    margin: 0;
  }

  .schedule-status {
    color: #52636e;
    font-size: 0.9rem;
    padding-bottom: 15px;
    border-bottom: 1px solid #dce3e7;
  }

  .schedule-note {
    margin-top: 20px;
    text-align: center;
  }

  .gold-section .modern-btn {
    margin-top: 12px;
  }
</style>

<script>
  const openingDate = Date.parse(
    '2027-01-01T00:00:00-05:00'
  );

  if (Date.now() >= openingDate) {
    const message = document.querySelector(
      '[data-schedule-opening]'
    );

    if (message) {
      message.textContent =
        'Spring 2027 registration is open!';
    }
  }
</script>
