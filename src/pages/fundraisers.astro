
---
import Layout from '../layouts/Layout.astro';

const benefits = [
  {
    icon: 'fa-wallet',
    title: 'Affordable Soccer',
    description:
      'Helping keep registration costs manageable and soccer accessible to local families.'
  },
  {
    icon: 'fa-futbol',
    title: 'Equipment & Fields',
    description:
      'Providing equipment, uniforms and well-maintained spaces for our players.'
  },
  {
    icon: 'fa-handshake',
    title: 'Player Experiences',
    description:
      'Supporting league programs and creating meaningful opportunities for our young athletes.'
  }
];
---

<Layout title="Fundraisers | Bald Eagle Youth Soccer">

  <!-- Page Hero -->
  <section class="program-hero fundraising-hero">
    <div class="modern-wrap">

      <p class="eyebrow">
        Bald Eagle Youth Soccer • Fundraising
      </p>

      <h1>
        Small Efforts.<br />
        <span>Big Impact.</span>
      </h1>

      <p>
        Working together to keep soccer affordable
        and accessible for our community.
      </p>

    </div>
  </section>

  <!-- Upcoming Fundraisers -->
  <section class="modern-section modern-wrap">

    <div class="modern-heading fundraiser-coming-soon">

      <i
        class="fa-solid fa-calendar-days section-icon"
        aria-hidden="true"
      ></i>

      <p class="eyebrow">
        2027 Fundraising Opportunities
      </p>

      <h2>Coming Soon!</h2>

      <p>
        We're planning another great year of soccer!
        Check back for upcoming fundraisers,
        important dates and ways to get involved.
      </p>

    </div>

  </section>

  <!-- Why We Fundraise -->
  <section class="modern-section soft-section">
    <div class="modern-wrap">

      <div class="modern-heading">

        <p class="eyebrow">Every Little Bit Helps</p>

        <h2>Why We Fundraise.</h2>

        <p>
          Every fundraiser helps us invest in our
          players, our program and our community.
        </p>

      </div>

      <div class="fundraising-benefits">

        {benefits.map(benefit => (
          <article class="modern-card benefit-card">

            <i
              class={`fa-solid ${benefit.icon}`}
              aria-hidden="true"
            ></i>

            <h3>{benefit.title}</h3>

            <p>{benefit.description}</p>

          </article>
        ))}

      </div>

    </div>
  </section>

  <!-- Thank You -->
  <section class="modern-section modern-wrap">

    <div class="modern-heading fundraising-thanks">

      <img
        src="/beyslogo.png"
        alt="Bald Eagle Youth Soccer"
        class="fundraising-logo"
        loading="lazy"
      />

      <p class="eyebrow">Our Soccer Family</p>

      <h2>Thank You, BEYS Families!</h2>

      <p>
        Whether you're selling, purchasing,
        volunteering or spreading the word,
        every contribution makes a difference.
        We're grateful for the community
        behind our players!
      </p>

    </div>

  </section>

  <!-- Sponsorship CTA -->
  <section class="modern-section gold-section">

    <div class="modern-wrap modern-heading">

      <p class="eyebrow">Support Local Youth Soccer</p>

      <h2>Together, We Make a Difference.</h2>

      <p>
        Looking for another way to support BEYS?
        Explore our business sponsorship opportunities
        and help us continue growing the game
        in our community.
      </p>

      <a class="modern-btn navy" href="/sponsors">
        Become a Community Partner →
      </a>

    </div>

  </section>

</Layout>

<style>
  .fundraising-hero h1 span {
    color: var(--gold);
  }

  .fundraising-hero p {
    max-width: 600px;
  }

  .fundraiser-coming-soon,
  .fundraising-thanks {
    max-width: 680px;
    margin: 0 auto;
  }

  .section-icon {
    font-size: 3rem;
    color: var(--navy);
    margin-bottom: 20px;
  }

  .fundraiser-coming-soon .eyebrow,
  .fundraising-thanks .eyebrow,
  .soft-section .eyebrow {
    color: #52636e;
  }

  .fundraising-benefits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .benefit-card {
    padding: 32px 24px;
    text-align: center;
  }

  .benefit-card i {
    font-size: 2rem;
    color: var(--navy);
    margin-bottom: 16px;
  }

  .benefit-card h3 {
    font-size: 1.4rem;
    margin: 8px 0 12px;
    text-transform: uppercase;
  }

  .benefit-card p {
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 0;
  }

  .fundraising-logo {
    display: block;
    width: 100px;
    height: auto;
    margin: 0 auto 24px;
  }

  .gold-section .modern-btn {
    margin-top: 12px;
  }

  @media (max-width: 768px) {
    .fundraising-benefits {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .benefit-card {
      padding: 24px;
    }
  }
</style>
