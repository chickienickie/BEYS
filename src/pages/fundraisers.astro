---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Fundraisers | Bald Eagle Youth Soccer">
    <!-- HERO -->
    <section class="page-hero">
        <h1>Fundraisers</h1>
    </section>

    <!-- FUNDRAISER INFO -->
    <section class="fundraisers-section">
        <div class="container">
            <h2>League Fundraisers</h2>
            <p>Fundraising helps support equipment, fields, uniforms, and league programs.</p>

            <div class="fundraiser-grid">

                <!-- MARIANNA'S FUNDRAISER -->
                <div class="fundraiser-card">
                    <h3>Marianna’s Fundraiser</h3>

                    <img src="/sub.png" alt="Marianna's Hoagies & Pizzas" class="sub-img">

                    <p>
                        Help support BEYS by participating in our <strong>Marianna’s Hoagies & Pizzas fundraiser!</strong>
                        This is a great way to enjoy some delicious food while helping provide for our players and league.
                    </p>

                    <p>
                        <strong>Orders Due:</strong> Thursday, September 10 at practice
                    </p>

                    <p>
                        <strong>Pick-Up:</strong> Friday, September 18 from 4:45 PM – 6:15 PM
                        at the Unionville Borough Building
                    </p>

                    <a href="/downloads/mariannasorderform.pdf" class="announcement-btn" download>
                        Download Order Form →
                    </a>

                    <div class="fundraiser-thankyou">
                        THANK YOU FOR SUPPORTING BEYS!
                    </div>
                </div>


                <!-- FALL FANWEAR STORE -->
                <div class="fundraiser-card">
                    <h3>BEYS 2026 Fall Fanwear Store</h3>

                    <img src="/beyslogo.png" alt="BEYS Logo" class="fundraiser-img">

                    <p>
                        Show your BEYS pride this season with official
                        <strong>2026 Fall BEYS fan gear!</strong>
                    </p>

                    <p>
                        The Fall Fanwear Store is open now and offers a great way to
                        support BEYS while showing your team spirit.
                    </p>

                    <p>
                        <strong>Store Closes:</strong> September 17 at midnight
                    </p>

                    <a
                        href="https://form.jotform.com/perrymaneveryday/fall-2026-beys-fan-gear"
                        class="announcement-btn"
                        target="_blank"
                        rel="noopener"
                    >
                        Shop the Fanwear Store →
                    </a>

                </div>
               
                  <!-- SOCCER SKILLS CAMP -->
                  <div class="fundraiser-card">
                    <h3>BEYS Soccer Skills Camp</h3>

                    <img src="/soccerplayer.png" alt="Soccer Camp" class="fundraiser-img">

                    <p>
                        We had a great morning at our BEYS Soccer Skills Camp!
                        Players enjoyed skill-building activities, drills, games, and
                        plenty of time on the field.
                    </p>

                    <p>
                        <strong>Date:</strong> Saturday, August 1
                    </p>

                    <p>
                        <strong>Time:</strong> 9:00 AM – 11:00 AM
                    </p>

                    <div class="fundraiser-thankyou">
                        THANK YOU TO EVERYONE WHO JOINED US!
                    </div>
                

            </div>
        </div>
    </section>
</Layout>