---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Bald Eagle Youth Soccer">
    <!-- HERO -->
    <section class="hero">
        <div class="hero-overlay">
            <img src="/beyslogo.png" class="hero-logo" alt="BEYS Logo">
            <h1>Bald Eagle Youth Soccer</h1>
            <p>Building Skills. Building Confidence. Building Community.</p>
            <div class="hero-buttons">
                <a class="register-btn"
                    href="https://login.stacksports.com/login?client_id=612b0399b1854a002e427f78&redirect_uri=https://core-api.bluesombrero.com/login/redirect/portal/6317&app_name=Bald+Eagle+Youth+Soccer&portalid=6317&instancekey=sports"
                    target="_blank"
                    aria-label="Register Now (opens in a new tab)">
                    Register Now
                </a>
                <a class="field-btn" href="/fields">
                    Field Locations
                </a>
            </div>
        </div>
    </section>

    <!-- PROGRAMS -->
    <section id="programs" class="programs">
        <h2>Our Programs</h2>
        <div class="program-grid">
            <div class="program-card">
                <h3>U6</h3>
                <p>Practice Tues & Thurs</p>
                <p>6:00–7:00 PM</p>
                <p class="games">In-house games Thursday nights</p>
            </div>
            <div class="program-card">
                <h3>U8</h3>
                <p>Practice Tues & Thurs</p>
                <p>6:00–7:30 PM</p>
                <p class="games">Games Saturdays 9:30 AM</p>
            </div>
            <div class="program-card">
                <h3>U10</h3>
                <p>Practice Tues & Thurs</p>
                <p>6:00–7:30 PM</p>
                <p class="games">Games Saturdays 11:00 AM</p>
            </div>
            <div class="program-card">
                <h3>U13</h3>
                <p>Practice Tues & Thurs</p>
                <p>6:00–7:30 PM</p>
                <p class="games">Games Saturdays 12:30 PM</p>
            </div>
        </div>
        
    </section>

    <!-- ANNOUNCEMENTS -->
    <section class="announcements">
        <h2>Important Announcements</h2>
        <div class="announcement-cards">
      
  <!-- ANNOUNCEMENT CARD 1: SEASON KICKOFF -->
<div class="announcement">

  <img src="/shoe.png" class="announcement-icon" alt="Soccer Practice">
  <span class="tag">Season Kickoff</span>

  <h3>Fall Soccer Starts Tonight!</h3>

  <p>
    Practices kick off Tuesday, September 1 at <strong>6:00 PM</strong> for all age groups!
  </p>

  <p>
    Registration tables will be set up along the fence, and our <strong>BEYS Cleat Swap bins</strong> will also be available.
  </p>

  <p>
    Please have players ready with cleats, shin guards, soccer socks, and a water bottle — ready to have some fun!
  </p>

  <p>
    We can't wait to see everyone back on the field and kick off another great season of Bald Eagle Youth Soccer! 💙💛⚽
  </p>

</div>


<!-- ANNOUNCEMENT CARD 2: FIRST GAMES -->
<div class="announcement">

  <img src="/soccerplayer.png" class="announcement-icon" alt="Soccer Games">
  <span class="tag">Game Day</span>

  <h3>First Games Begin September 12!</h3>

  <p>
    The first games of the Fall 2026 season will take place Saturday, September 12 for our <strong>U8, U10, and U13</strong> teams.
  </p>

  <p>
    Team assignments will be completed by coaches on September 1 and communicated to families this week.
  </p>

  <p>
    Team schedules are now posted on our website.
  </p>

  <a href="/schedule" class="announcement-btn">
    View Team Schedules →
  </a>

</div>


<!-- ANNOUNCEMENT CARD 3: FALL PICTURES -->
<div class="announcement">

  <img src="/camera-regular.png" class="announcement-icon" alt="Soccer Pictures">
  <span class="tag">Fall Pictures</span>

  <h3>Soccer Pictures Are Coming!</h3>

  <p>
    <strong>Tuesday, September 15 & Thursday, September 17</strong>
  </p>

  <p>
    Fall soccer pictures will be taken by <strong>VJM Photography</strong>.
  </p>

  <p>
    Stay tuned for information about which teams are scheduled for each day!
  </p>

  <a href="/jvmorderform.pdf" class="announcement-btn" download>
    Download Photo Form →
  </a>

</div>


<!-- ANNOUNCEMENT CARD 4: FUNDRAISER -->
<div class="announcement">

  <img src="/soccerball.png" class="announcement-icon" alt="Fundraiser">
  <span class="tag">Fundraiser</span>

  <h3>Marianna's Fundraiser Reminder</h3>

  <p>
    <strong>Orders and payment are due Thursday, September 10 at practice.</strong>
  </p>

  <p>
    <strong>Fundraiser Pick-Up:</strong><br>
    Friday, September 18<br>
    <strong>4:45–6:15 PM</strong><br>
    Unionville Borough Building
  </p>

  <p>
    Thank you for supporting Bald Eagle Youth Soccer! 💙💛⚽
  </p>

  <a href="/BEYSMariannaForm.pdf" class="announcement-btn" download>
    Download Fundraiser Form →
  </a>

</div>
    </section>
