---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Bald Eagle Youth Soccer">
    <!-- HERO -->
    <section class="hero">
        <div class="hero-overlay">
            <img src="/beyslogo.png" class="hero-logo" alt="BEYS Logo">
            <h1>Bald Eagle Youth Soccer</h1>
            <p>Building Skills. Building Confidence. Building Community.</p>
            <div class="hero-buttons">
                <a class="register-btn"
                    href="https://login.stacksports.com/login?client_id=612b0399b1854a002e427f78&redirect_uri=https://core-api.bluesombrero.com/login/redirect/portal/6317&app_name=Bald+Eagle+Youth+Soccer&portalid=6317&instancekey=sports"
                    target="_blank"
                    aria-label="Register Now (opens in a new tab)">
                    Register Now
                </a>
                <a class="field-btn" href="/fields">
                    Field Locations
                </a>
            </div>
        </div>
    </section>

    <!-- PROGRAMS -->
    <section id="programs" class="programs">
        <h2>Our Programs</h2>
        <div class="program-grid">
            <div class="program-card">
                <h3>U7</h3>
                <p>Practice Tues & Thurs</p>
                <p>6:00–7:00 PM</p>
                <p class="games">In-house games Thursday nights</p>
            </div>
            <div class="program-card">
                <h3>U9</h3>
                <p>Practice Tues & Thurs</p>
                <p>6:00–7:30 PM</p>
                <p class="games">Games Saturdays 9:30 AM</p>
            </div>
            <div class="program-card">
                <h3>U11</h3>
                <p>Practice Tues & Thurs</p>
                <p>6:00–7:30 PM</p>
                <p class="games">Games Saturdays 11:00 AM</p>
            </div>
            <div class="program-card">
                <h3>U13</h3>
                <p>Practice Tues & Thurs</p>
                <p>6:00–7:30 PM</p>
                <p class="games">Games Saturdays 12:30 PM</p>
            </div>
        </div>
        
    </section>

    <!-- ANNOUNCEMENTS -->
    <section class="announcements">
        <h2>Important Announcements</h2>
        <div class="announcement-cards">
            <!-- FUNDRAISER -->
            <!-- BATTLE OF THE EAGLES -->
<div class="announcement">

    <img src="/field2.png" class="announcement-icon" alt="Soccer Stadium">
  
    <span class="tag">Special Event</span>
  
    <h3>Battle of the Eagles: Under the Lights</h3>
  
    <p>
      Get ready for an exciting night of soccer, fun, food, and community spirit as our two Bald Eagle Youth Soccer U13 teams go head-to-head at Alumni Stadium!
    </p>
  
    <p><strong>Date:</strong> Saturday, May 16</p>
  
    <p><strong>Kickoff:</strong> 6:00 PM</p>
  
    <p><strong>Location:</strong> Bald Eagle Area Alumni Stadium</p>
  
    <p>
      Bring your family, wear your BEYS gear, and come cheer on our players for a memorable night under the lights! ⚽🦅
    </p>
  
  </div>
  
  
  <!-- SUMMER SKILLS CAMP -->
  <div class="announcement">
  
    <img src="/soccerplayer.png" class="announcement-icon" alt="Soccer Camp">
  
    <span class="tag">Skills Camp</span>
  
    <h3>BEYS Soccer Skills Camp!</h3>
  
    <p>
      Keep the soccer fun going this summer with our BEYS Soccer Skills Camp!
    </p>
  
    <p><strong>Date:</strong> August 1</p>
  
    <p><strong>Time:</strong> 9:00 AM – 11:00 AM</p>
  
    <p>
      Players will enjoy skill-building activities, fun drills, games, and more while continuing to grow their confidence on the field.
    </p>
  
    <p>
      Registration and additional details will be announced soon!
    </p>
  
  </div>
  
  
  <!-- END OF SEASON PARTY -->
  <div class="announcement">
  
    <img src="/party.png" class="announcement-icon" alt="Season Celebration">
  
    <span class="tag">Celebrate</span>
  
    <h3>End of the Season Party</h3>
  
    <p>
      Let’s celebrate an amazing Spring 2026 season together with food & fun during practice at the fields!
    </p>
  
    <p><strong>Date:</strong> May 26</p>
  
    <p>
      Enjoy pizza, drinks, snow cones, and more as we wrap up another great season of Bald Eagle Youth Soccer.
    </p>
  
    <p>
      We can’t wait to celebrate our players, families, coaches, and community together! ⚽🦅
    </p>
  
  </div>
            
            <!-- FOOD TRUCKS -->
            <div class="announcement">
                <img src="/foodtruck.png" class="announcement-icon" alt="" aria-hidden="true">
                <span class="tag">Game Day</span>
                <h3>Soccer Saturdays Food Trucks</h3>
                <p>
                    Make game day even better! Join us every Saturday for a rotating lineup of local food trucks.
                </p>
                <p><strong>Time:</strong> 9:00 AM – 2:00 PM</p>
                <p><strong>Location:</strong> Bald Eagle Youth Soccer Fields</p>
                <a href="/foodtrucks" class="primary-btn">
                    View Food Truck Schedule
                </a>
            </div>
            <!-- NEW PROGRAM UPDATE -->
            <div class="announcement">
                <img src="/soccerball.png" class="announcement-icon" alt="" aria-hidden="true">
                <span class="tag">New This Season</span>
                <h3>U11 & U13 Friendly Games</h3>
                <p>
                    We’re excited to introduce something <em>extra fun</em> this year!
                </p>
                <p>
                    U11 and U13 teams will take part in Friendly Thursday Games with Centre Soccer Association.
                </p>
                <p><strong>What to expect:</strong></p>
                <p>⚽ One additional friendly game per team</p>
                <p>📅 Played during a regular Thursday practice</p>
                <p>🤝 Fun, development-focused competition</p>
            </div>

            

            
           
        </div>
    </section>
    <section id="junior-high-soccer">
        <h2>Continuing the Soccer Journey</h2>
        <p>As part of the BEYS mission, we encourage players to continue developing their love for soccer beyond youth league play. Sixth grade families interested in Junior High Soccer can join using the SportsYou codes below.</p>
        
        <div class="program-grid">
          <div class="program-card">
            <h3>Girls Junior High Soccer</h3>
            <p><strong>Code:</strong> RNUA-LRKK</p>
          </div>
          <div class="program-card">
            <h3>Boys Junior High Soccer</h3>
            <p><strong>Code:</strong> Z456-5Q69</p>
          </div>
        </div>
        <p><strong>If your child is planning to play Junior High Soccer make sure they fill out the paperwork and take advantage of the free school physical, as it will be needed for play.</strong></p>
        <div class="coaching-info">
          <p>Interested in coaching the Girls Junior High team next season?<br>
          Please contact Joanne Nagle at 570-881-7174.</p>
        </div>
       
      </section>
</Layout>