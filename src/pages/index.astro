---
import Layout from "../layouts/Layout.astro";

const travelInterestUrl = "/travel/#travel-interest";
---


<Layout title="Bald Eagle Youth Soccer | Recreational & Travel Soccer">
    <section class="new-hero">
        <div class="modern-wrap hero-content">
            <p class="eyebrow">Growing BEYS together • Spring 2027</p><h1>
                One league.<br />Two ways<br /><em>to play.</em>
            </h1>
            <p>
                BEYS is now offering both
                recreational and travel soccer for the Spring 2027 season.
                </p>
                <p>
                    More opportunities to play, grow, and love the game. 
               </p>
               <div class="modern-actions">
                <a class="modern-btn" href="#programs">Explore our programs →</a
                >
            </div>
        </div>
        <img
    src="/beyslogo.png"
    alt="Bald Eagle Youth Soccer"
    class="hero-club-logo"
    width="340"
    height="340"
/>
    </section>

    <div class="date-strip">
        <div class="modern-wrap two-grid">
    
            <div>
                <span class="eyebrow">
                    Spring Soccer Registration
                </span>
    
                <h2 data-opening-date>
                    January 1 – February 5, 2027
                </h2>
    
                <p data-registration-details>
                    Recreational &amp; Travel Soccer Registration Opens 1/1/27 and Closes 2/5/27
                </p>
    
                <a
                    data-registration-link
                    href="https://login.stacksports.com/login?client_id=612b0399b1854a002e427f78&redirect_uri=https://core-api.bluesombrero.com/login/redirect/portal/6317&app_name=Bald+Eagle+Youth+Soccer&portalid=6317&instancekey=sports"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Register for Rec or Travel Soccer →
                </a>
            </div>
    
            <div>
                <span class="eyebrow">
                    Business Sponsorships
                </span>
    
                <h2 data-sponsor-heading>
                    January 1, 2027 – February 5, 2027
                </h2>
    
                <p>2027 Sponsorship Opportunities</p>
    
                <a href="/sponsors/">
                    Become a community partner →
                </a>
            </div>
    
        </div>
    </div>
    
    <section id="programs" class="modern-section modern-wrap">
        <div class="modern-heading">
            <p class="eyebrow">Our programs</p><h2>
                Find your fit on the field.
            </h2><p>Two programs. One BEYS community.</p>
        </div><div class="two-grid">
            <article class="modern-card">
                <div class="modern-card-head">
                    <span class="eyebrow">Learn • Play • Grow</span><h3>
                        Recreational Soccer
                    </h3>
                </div><div class="modern-card-body">
                    <p>
                        A fun, supportive environment to build skills, make
                        friends and develop a love for soccer.
                    </p><div class="modern-schedule">
                        <small>Age Groups</small>
                        <strong>U6, U8, U10 &amp; U13</strong>
                      
                        <small>Practices</small>
                        <strong>Tuesday &amp; Thursday</strong>
                      
                        <small>Game Day</small>
                        <strong>Saturday*</strong>
                        <p class="fine-print">*U6 recreational games are held on Thursday evenings.</p>
                      </div><a href="/recreational">Recreational soccer info →</a>
                </div>
            </article>
            <article class="modern-card">
                <div class="modern-card-head">
                    <span class="eyebrow">Develop • Challenge • Compete</span
                    ><h3>Travel Soccer</h3>
                </div><div class="modern-card-body">
                    <p>
                        A competitive experience for motivated players ready to
                        challenge themselves and take their skills to the next
                        level.
                    </p><div class="modern-schedule">
                        <small>Proposed Age Groups</small>
                        <strong>U10 &amp; U12 (Grades 3–6)</strong>
                      
                        <small>Practices</small>
                        <strong>Monday &amp; Wednesday</strong>
                      
                        <small>Game Day</small>
                        <strong>Sunday</strong>
                        <p class="fine-print">*Teams depend on eligibility, roster sizes and coaching availability.</p>
                      </div><a href="/travel">Travel soccer info →</a>
                </div>
            </article>
        </div>
    </section>
    <section class="modern-wrap home-quick-links" aria-label="Quick links">
        <a href="/schedule"
            ><i class="fa-solid fa-calendar-days" aria-hidden="true"></i> Game Schedules
            <span aria-hidden="true">→</span></a
        >
        <a href="/fields"
            ><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Fields &amp;
            Directions <span aria-hidden="true">→</span></a
        >
        <a href="/foodtrucks"
            ><i class="fa-solid fa-truck" aria-hidden="true"></i> Food Trucks <span
                aria-hidden="true">→</span
            ></a
        >
    </section>
    <section class="modern-section soft-section">
        <div class="modern-wrap two-grid">
            <div>
                <p class="eyebrow">Explore BEYS travel soccer</p><h2>
                    Ready for the next level?
                </h2><p>
                    Interested in travel soccer? We'd love to hear from
                    you!
                </p><div class="modern-actions">
                    <a class="modern-btn navy" href={travelInterestUrl}>
                        Express Interest →
                    </a><a
                        class="modern-btn line"
                        href="/downloads/beys-travel-soccer-guide.pdf"
                        download>Parent guide (PDF) ↓</a>
                </div>
            </div><div class="fact-panel">
                <p>
                    <strong>U10 &amp; U12</strong><br />Grades 3–6 • Boys &amp;
                    Girls
                </p><p>
                    <strong>$100 per season</strong><br />Uniform included
                </p><p>
                    <strong>PA West Soccer</strong><br />Mountain District
                    League
                </p><small
                    >Teams depend on eligibility, roster sizes and coaching
                    availability.</small>
            </div>
        </div>
    </section>

<!-- BEYS BINGO SAVE THE DATE -->
<section class="modern-section bingo-section">
    <div class="modern-wrap modern-heading">

        <i
            class="fa-solid fa-calendar-days bingo-icon"
            aria-hidden="true"
        ></i>

        <p class="eyebrow">Mark your calendars</p>

        <h2 class="bingo-heading">
            Save the date.
            <span class="bingo-event-name">BEYS</span>
          
            <span class="bingo-letters" aria-label="Bingo">
              <span class="bingo-ball" aria-hidden="true">B</span>
              <span class="bingo-ball" aria-hidden="true">I</span>
              <span class="bingo-ball" aria-hidden="true">N</span>
              <span class="bingo-ball" aria-hidden="true">G</span>
              <span class="bingo-ball" aria-hidden="true">O</span>
            </span>
          </h2>

        <p class="bingo-date">
            Saturday, March 6, 2027
        </p>

        <p class="bingo-location">
            <i
                class="fa-solid fa-location-dot"
                aria-hidden="true"
            ></i>
            Bald Eagle Area High School
        </p>

        <p class="bingo-description">
            Join us for a fun-filled community event
            supporting Bald Eagle Youth Soccer!
        </p>

        <span class="bingo-coming-soon">
            More details coming soon
        </span>

    </div>
</section>

    <section class="modern-section gold-section">
        <div class="modern-wrap modern-heading">
            <p class="eyebrow">2027 sponsorship opportunities</p><h2>
                Local support. Lasting impact.
            </h2><p>
                Help us create more opportunities for our young athletes.
                Partner with BEYS and make a difference in our soccer community.
            </p><p>
                <strong data-sponsor-date
                    >Sponsorships open January 1, 2027</strong>
            </p><a class="modern-btn navy" href="/sponsors"
                >Become a community partner →</a>
        </div>
    </section>
   
<!-- 2026 SPONSOR RECOGNITION -->
<section class="sponsor-thank-you">
    <div class="modern-wrap">
  
      <i
        class="fa-solid fa-handshake-angle sponsor-thank-you-icon"
        aria-hidden="true"
      ></i>
  
      <p class="eyebrow">Stronger together</p>
  
      <h2>Thank You To Our 2026 Sponsors.</h2>
  
      <p class="sponsor-thank-you-intro">
        Your generosity helped our players learn, grow and
        make memories on and off the field. We're grateful
        to have such an incredible community behind us.
      </p>
  
      <div class="sponsor-name-group">
        <h3>Gold Sponsors</h3>
        <ul class="sponsor-name-list">
          <li>DeadRiver Remodeling &amp; Construction LLC</li>
          <li>Gourmet Griddle Co.</li>
          <li>The Junction 144</li>
          <li>Big D's Cones &amp; Shakes</li>
          <li>R &amp; S Corl Transportation</li>
          <li>Anonymous Community Sponsor</li>
        </ul>
      </div>
  
      <div class="sponsor-name-group">
        <h3>Blue Sponsors</h3>
        <ul class="sponsor-name-list">
          <li>Nature's Cover</li>
          <li>Loyal Order of Moose Lodge 1565</li>
          <li>American Legion Mumper Shawley Post</li>
        </ul>
      </div>
  
      <a class="sponsor-thank-you-link" href="/sponsors/">
        Meet our community sponsors →
      </a>
  
    </div>
  </section>
  

  
<!-- CONTINUE THE SOCCER JOURNEY -->
<section id="junior-high-soccer" class="journey-section">
  <div class="modern-wrap">

    <div class="journey-heading">
      <i class="fa-solid fa-futbol" aria-hidden="true"></i>

      <p class="eyebrow">Beyond BEYS</p>

      <h2>Continue The Journey.</h2>

      <p class="journey-description">
        The love of the game doesn't end at BEYS.
        We encourage our players to continue growing,
        competing and representing our community
        through Bald Eagle Area school soccer.
      </p>

      <p class="journey-description">
        Sixth grade families interested in junior high
        soccer can connect using the SportsYou codes below.
      </p>
    </div>

    <div class="journey-grid">

      <article class="journey-card">
        <h3>Girls Junior High Soccer</h3>
        <p class="journey-code-label">SportsYou Code</p>
        <span class="journey-code">RNUA-LRKK</span>
      </article>

      <article class="journey-card">
        <h3>Boys Junior High Soccer</h3>
        <p class="journey-code-label">SportsYou Code</p>
        <span class="journey-code">Z456-5Q69</span>
      </article>

    </div>

    <p class="journey-note">
      School soccer programs are organized separately from BEYS.
    </p>

  </div>
</section>

</Layout>
<style>
    .home-quick-links {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        padding-bottom: 48px;
    }
    .home-quick-links a,
    .home-quick-links a:visited {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 18px;
        border: 1px solid #dce3e7;
        border-radius: 6px;
        color: #002a43;
        text-decoration: none;
        font-weight: 600;
    }
    .home-quick-links a:hover {
        background: #f2f5f6;
    }
    .home-quick-links span {
        margin-left: auto;
    }
    @media (max-width: 768px) {
        .home-quick-links {
            grid-template-columns: 1fr;
            padding-bottom: 32px;
        }
    }
</style>

<script>
    function updateHomeDates() {
        const openingDate = Date.parse(
            "2027-01-01T00:00:00-05:00"
        );

        const closingDate = Date.parse(
            "2027-02-06T00:00:00-05:00"
        );

        const now = Date.now();

        const registrationHeading =
            document.querySelector("[data-opening-date]");

        const registrationDetails =
            document.querySelector("[data-registration-details]");

        const registrationLink =
            document.querySelector<HTMLAnchorElement>(
                "[data-registration-link]"
            );

        if (now >= closingDate) {
            if (registrationHeading) {
                registrationHeading.textContent =
                    "Registration Is Closed";
            }

            if (registrationDetails) {
                registrationDetails.textContent =
                    "Spring 2027 Soccer";
            }

            if (registrationLink) {
                registrationLink.textContent =
                    "Explore our soccer programs →";

                registrationLink.href = "#programs";
                registrationLink.removeAttribute("target");
                registrationLink.removeAttribute("rel");
            }

        } else if (now >= openingDate) {
            if (registrationHeading) {
                registrationHeading.textContent =
                    "Registration Is Open!";
            }

            if (registrationDetails) {
                registrationDetails.textContent =
                    "Register by February 5, 2027";
            }
        }

        if (now >= openingDate) {
            document
                .querySelectorAll("[data-sponsor-date]")
                .forEach((el) => {
                    el.textContent =
                        "2027 Sponsorships Are Open";
                });

            const sponsorHeading =
                document.querySelector("[data-sponsor-heading]");

            if (sponsorHeading) {
                sponsorHeading.textContent =
                    "Sponsorships Are Open";
            }
        }
    }

    updateHomeDates();

    document.addEventListener(
        "astro:page-load",
        updateHomeDates
    );
</script>
