---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Partner With BEYS | Bald Eagle Youth Soccer">

    <!-- HERO -->
    <section class="sponsor-intro">

        <div class="container">

            <h1>Partner With Bald Eagle Youth Soccer</h1>

    

            <p>
                Bald Eagle Youth Soccer (BEYS) is a 501(c)(3) nonprofit organization committed to
                providing a positive, affordable soccer experience for children throughout the Bald Eagle
                Area.
            </p>

            <p>
                Each season, over 100 young athletes participate in our recreational program, where
                they develop teamwork, confidence, sportsmanship, love for the game, and lifelong
                friendships in a fun and encouraging environment.
            </p>

            <p>
                As a nonprofit, we rely on the generosity of local businesses and community partners to
help keep soccer accessible for every family.Your sponsorship directly supports our players while demonstrating your commitment to
the families who make up our community.
            </p>
    

            <div class="sponsor-buttons">

                <a href="/downloads/2026-sponsorship-packet.pdf" class="button">
                    Download Sponsorship Packet
                </a>

                <a href="#sponsor-form" class="button">
                    Become a Partner
                </a>

            </div>

        </div>

    </section>



   <!-- WHY PARTNER -->
<section class="why-sponsor">

    <div class="container">

        <h2>Why Partner With BEYS?</h2>

        <p>
            Community partners make it possible for us to keep registration affordable while
            providing players with the equipment, fields, and resources needed for a successful season.
        </p>

        <ul class="sponsor-benefits">
            <li><strong>Reach</strong> hundreds of local families throughout the season</li>
            <li><strong>Support</strong> youth athletes in our community</li>
            <li><strong>Help</strong> keep registration affordable for all families</li>
            <li><strong>Invest</strong> in healthy lifestyles and positive youth development</li>
            <li><strong>Increase</strong> your business visibility and gain exposure across multiple communities in Central PA</li>
        </ul>

    </div>

</section>




    <!-- SPONSOR LEVELS -->
    <section class="sponsor-levels">

        <div class="container">

            <h2>2026 Sponsorship Opportunities</h2>


            <div class="sponsor-grid">


                <div class="sponsor-card blue-sponsor">
                    <h3>⚽ Blue Community Sponsor</h3>

                    <h4>Contributions up to $299</h4>

                    <ul>
                        <li>Business name/logo displayed on BEYS website</li>
                        <li>$100+ contributions receive field signage</li>
                    </ul>

                </div>



                <div class="sponsor-card featured-sponsor">

                    <h3>🏆 Gold Team Sponsor</h3>

                    <h4>$300+</h4>

                    <ul>
                        <li>Business logo/name displayed on team jerseys</li>
                        <li>Select jersey color for your sponsored team</li>
                        <li>Website recognition</li>
                        <li>Field signage during Fall and Spring seasons</li>
                        <li>Gain more exposure across multiple communities in Central PA</li>
                    </ul>

                </div>


            </div>

        </div>

    </section>




 <!-- IMPACT -->
<section class="impact">

    <div class="container">

        <h2>Your Partnership Helps Provide</h2>

        <p>
            Your support directly impacts our players by helping us provide the resources
            needed for a successful season.
        </p>

        <ul class="impact-list">

            <li>✔️ Player jerseys and uniforms</li>
            <li>✔️ Goals, nets, and field equipment</li>
            <li>✔️ Practice and training equipment</li>
            <li>✔️ Field maintenance and preparation</li>
            <li>✔️ Affordable registration opportunities for families</li>
            <li>✔️ Creating positive experiences for local youth</li>
        
        </ul>

    </div>

</section>



    <!-- FORM CTA -->
    <section class="sponsor-cta">

        <div class="container">

            <h2>Ready To Partner With BEYS?</h2>

            <p>
                Join the businesses and community members helping provide a positive soccer
                experience for local youth.
            </p>


            <a href="#sponsor-form" class="button">
                Become a BEYS Partner
            </a>

        </div>

    </section>




    <!-- FORM -->
    <section id="sponsor-form" class="sponsor-form">

        <div class="container">


            <h2>Become a BEYS Community Partner</h2>


            <p>
                Complete the form below and we will follow up with sponsorship details,
                payment options, and logo information.
            </p>



            <div class="sponsor-trust">

                <span>⚽ Over 100 Players each season</span>
                <span>🏆 501(c)(3) Nonprofit</span>
                <span>❤️ Community Supported</span>

            </div>




            <!-- Netlify Detection -->

            <form name="sponsor-interest" netlify hidden>

                <input type="text" name="business-name" />
                <input type="text" name="contact-name" />
                <input type="email" name="email" />
                <input type="tel" name="phone" />
                <input type="text" name="website" />
                <input type="text" name="sponsorship-level" />
                <input type="text" name="jersey-color" />
                <textarea name="message"></textarea>

            </form>





            <form
                name="sponsor-interest"
                method="POST"
                data-netlify="true"
                class="contact-form"
            >

                <input type="hidden" name="form-name" value="sponsor-interest" />


                <label>
                    Business Name *
                    <input type="text" name="business-name" required />
                </label>


                <label>
                    Contact Person *
                    <input type="text" name="contact-name" required />
                </label>


                <label>
                    Email *
                    <input type="email" name="email" required />
                </label>


                <label>
                    Phone Number
                    <input type="tel" name="phone" />
                </label>


                <label>
                    Business Website or Social Media
                    <input type="text" name="website" placeholder="https://" />
                </label>


                <label>
                    Sponsorship Level *
                    <select name="sponsorship-level" required>

                        <option value="">
                            Select sponsorship level
                        </option>

                        <option>
                            Gold Team Sponsor ($300+)
                        </option>

                        <option>
                            Blue Community Sponsor (Up to $299)
                        </option>

                        <option>
                            General Donation
                        </option>

                    </select>
                </label>


                <label>
                    Preferred Jersey Color (Gold Sponsors)
                    <input 
                        type="text"
                        name="jersey-color"
                        placeholder="Example: Navy, Gold, White"
                    />
                </label>



                <label class="checkbox-option">

                    <input 
                        type="checkbox"
                        name="logo-email"
                        value="Will email logo"
                    />

                    I will email my logo to BEYS

                </label>




                <label>
                    Additional Notes

                    <textarea
                        name="message"
                        rows="5"
                        placeholder="Anything else you would like us to know?"
                    ></textarea>

                </label>



                <input
                    type="hidden"
                    name="source"
                    value="Website Sponsor Page"
                />



                <button type="submit" class="button">
                    Become a BEYS Partner
                </button>


            </form>


        </div>

    </section>




    <!-- FAQ -->
    <section class="sponsor-faq">

        <div class="container">

            <h2>Frequently Asked Questions</h2>


            <div class="faq-grid">

                <div class="faq-item">
                    <h3>Is my sponsorship tax deductible?</h3>
                    <p>
                        Yes. Bald Eagle Youth Soccer is a registered 501(c)(3)
                        nonprofit organization. Donations are tax deductible
                        to the extent permitted by law.
                    </p>
                </div>


                <div class="faq-item">
                    <h3>How will my business be recognized?</h3>
                    <p>
                        Sponsors may receive recognition through team jerseys,
                        field signage, and the BEYS website.
                    </p>
                </div>


                <div class="faq-item">
                    <h3>When is the sponsorship deadline?</h3>
                    <p>
                        Sponsorships must be submitted by
                        <strong>Jersey Order Deadline: September 1, 2026</strong>
                        to be included on team jerseys.
                    </p>
                </div>


                <div class="faq-item">
                    <h3>Can I sponsor more than one team?</h3>
                    <p>
                        Yes! Additional support is always welcome.
                    </p>
                </div>


            </div>

        </div>

    </section>




    <!-- COMMUNITY PARTNERS -->
    <section class="sponsor-news">

        <div class="container">

            <h2>Thank You To Our Community Partners</h2>

            <p>
                We are grateful to the businesses, organizations, families,
                and individuals who help make youth soccer possible.
            </p>


   

        </div>

    </section>


</Layout>