---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Partner With BEYS | Bald Eagle Youth Soccer">

    <!-- PARTNER HERO -->
    <section class="sponsor-intro">
        <div class="container">

            <h1>Partner With Bald Eagle Youth Soccer</h1>

            <p>
                Help nearly <strong>100 local youth athletes</strong> learn, compete, and grow
                while showcasing your business throughout our community.
            </p>

            <p>
                Bald Eagle Youth Soccer (BEYS) is a volunteer-run nonprofit organization
                dedicated to providing an affordable, positive soccer experience where kids
                can build skills, confidence, friendships, and lasting memories.
            </p>

            <div class="sponsor-buttons">
                <a href="/2026-sponsorship-packet.pdf" class="button">
                    Download Sponsorship Packet
                </a>

                <a href="/sponsor-form" class="button">
                    Become a Partner
                </a>
            </div>

        </div>
    </section>


    <!-- WHY PARTNER -->
    <section class="why-sponsor">

        <div class="container">

            <h2>Why Partner With BEYS?</h2>

            <p>
                Community partners make it possible for us to keep registration affordable
                while providing players with the equipment, fields, and resources needed
                for a successful season.
            </p>

            <div class="sponsor-grid">

                <div class="sponsor-card">
                    <h3>⚽ Nearly 100 Players</h3>
                    <p>
                        Support local youth athletes and their families.
                    </p>
                </div>

                <div class="sponsor-card">
                    <h3>🏆 Fall & Spring Seasons</h3>
                    <p>
                        Gain visibility throughout the year.
                    </p>
                </div>

                <div class="sponsor-card">
                    <h3>❤️ Community Impact</h3>
                    <p>
                        Help create opportunities for local children.
                    </p>
                </div>

                <div class="sponsor-card">
                    <h3>501(c)(3) Nonprofit</h3>
                    <p>
                        Donations are tax deductible as permitted by law.
                    </p>
                </div>

            </div>

        </div>

    </section>


    <!-- SPONSOR LEVELS -->
    <section class="sponsor-levels">

        <div class="container">

            <h2>2026 Sponsorship Opportunities</h2>


            <div class="sponsor-grid">


                <div class="sponsor-card">

                    <h3>⚽ Blue Community Sponsor</h3>

                    <h4>Contributions up to $299</h4>

                    <ul>
                        <li>Business name/logo displayed on BEYS website</li>
                        <li>$100+ contributions receive field signage during Fall and Spring seasons</li>
                    </ul>

                </div>



                <div class="sponsor-card">

                    <h3>🏆 Gold Team Sponsor</h3>

                    <h4>$300+</h4>

                    <ul>
                        <li>Business logo/name displayed on team jerseys</li>
                        <li>Select jersey color for your sponsored team</li>
                        <li>Business recognition on BEYS website</li>
                        <li>Field signage during Fall and Spring seasons</li>
                    </ul>

                </div>


            </div>

        </div>

    </section>


    <!-- SPONSOR IMPACT -->
    <section class="impact">

        <div class="container">

            <h2>Your Partnership Helps Provide</h2>

            <div class="sponsor-grid">

                <div class="sponsor-card">
                    ⚽ Player Jerseys
                </div>

                <div class="sponsor-card">
                    🥅 Goals & Nets
                </div>

                <div class="sponsor-card">
                    🎯 Training Equipment
                </div>

                <div class="sponsor-card">
                    🌱 Field Maintenance
                </div>

                <div class="sponsor-card">
                    👟 Affordable Registration
                </div>

                <div class="sponsor-card">
                    ❤️ Youth Opportunities
                </div>

            </div>

        </div>

    </section>



    <!-- CALL TO ACTION -->
    <section class="sponsor-cta">

        <div class="container">

            <h2>Ready To Partner With BEYS?</h2>

            <p>
                Join the businesses and community members helping provide a positive
                soccer experience for local youth.
            </p>

            <a class="button" href="/sponsor-form">
                Complete Sponsorship Form
            </a>

        </div>

    </section>



    <!-- FAQ -->
    <section class="sponsor-faq">

        <div class="container">

            <h2>Frequently Asked Questions</h2>


            <div class="faq-grid">


                <div class="faq-item">
                    <h3>Is my sponsorship tax deductible?</h3>
                    <p>
                        Yes. Bald Eagle Youth Soccer is a registered 501(c)(3)
                        nonprofit organization (EIN #45-0666301). Donations are
                        tax deductible to the extent permitted by law.
                    </p>
                </div>


                <div class="faq-item">
                    <h3>How will my business be recognized?</h3>
                    <p>
                        Sponsors may receive recognition through team jerseys,
                        field signage, and the BEYS website throughout the
                        Fall and Spring seasons.
                    </p>
                </div>


                <div class="faq-item">
                    <h3>When is the sponsorship deadline?</h3>
                    <p>
                        To be included on team jerseys and sponsorship materials,
                        please submit sponsorship by <strong>&lt;Jersey Order Deadline&gt;</strong>.
                    </p>
                </div>


                <div class="faq-item">
                    <h3>Can I sponsor more than one team?</h3>
                    <p>
                        Absolutely! Businesses are welcome to provide additional
                        support beyond the listed sponsorship levels.
                    </p>
                </div>


                <div class="faq-item">
                    <h3>How do I provide my logo?</h3>
                    <p>
                        After becoming a partner, BEYS will collect your logo
                        and any additional information needed.
                    </p>
                </div>


                <div class="faq-item">
                    <h3>Can individuals support BEYS?</h3>
                    <p>
                        Yes! Families, individuals, and community members are
                        welcome to support youth soccer.
                    </p>
                </div>


            </div>

        </div>

    </section>



    <!-- COMMUNITY PARTNERS -->
    <section class="sponsor-news">

        <div class="container">

            <h2>Thank You To Our Community Partners</h2>

            <p>
                We are grateful for the businesses, organizations, families,
                and individuals who help make youth soccer possible.
            </p>


            <div class="sponsor-grid">

                <div class="sponsor-card">Ingram’s Market</div>
                <div class="sponsor-card">Arize Federal Credit Union</div>
                <div class="sponsor-card">Nittany Meat Market</div>
                <div class="sponsor-card">Weis Market (Bellefonte)</div>
                <div class="sponsor-card">Walmart (Benner Pike)</div>
                <div class="sponsor-card">Karen Day</div>
                <div class="sponsor-card">Alaina Lucas</div>
                <div class="sponsor-card">Todd and Elaine Warner</div>
                <div class="sponsor-card">Nancy Warner</div>
                <div class="sponsor-card">Danielle Fritchman</div>

            </div>


            <p class="volunteer-thanks">
                Thank you to our family and friend volunteers who helped make our events successful!
            </p>


        </div>

    </section>


</Layout>