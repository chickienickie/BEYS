---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Sponsors | Bald Eagle Youth Soccer">
<section class="program-hero sponsor-hero"><div class="modern-wrap">
<p class="eyebrow">Community partners • 2027</p>
<h1>Local support.<br/><span>Lasting impact.</span></h1>
<p>Help us keep soccer affordable and create more opportunities for young athletes in the Bald Eagle Area.</p>
<p data-sponsor-date><strong>2027 sponsorships open January 1.</strong></p>
<div class="modern-actions"><a class="modern-btn" href="#sponsor-form">Become a community partner →</a><a class="modern-btn outline" href="#levels">Explore sponsorship levels</a></div>
</div></section>
<section class="modern-section modern-wrap"><div class="two-grid"><div><p class="eyebrow">Invest in our community</p><h2>More than a game.</h2><p>BEYS is a 501(c)(3) nonprofit organization committed to providing a positive, affordable soccer experience. Your support helps young athletes build confidence, teamwork and lifelong friendships.</p></div><div class="fact-panel"><strong>Your partnership helps provide:</strong><ul><li>Player uniforms and training equipment</li><li>Goals, nets and field maintenance</li><li>Affordable registration opportunities</li><li>Positive experiences for local youth</li></ul></div></div></section>
<section id="levels" class="modern-section soft-section"><div class="modern-wrap"><div class="modern-heading"><p class="eyebrow">2027 sponsorship opportunities</p><h2>Find your way to give.</h2><p>Support our players at a level that works for your business.</p></div><div class="two-grid tier-grid">
<article class="modern-card"><div class="modern-card-head"><p class="eyebrow">Community support</p><h3>Blue Community Sponsor</h3><strong>Up to $299</strong></div><div class="modern-card-body"><ul><li>Business name or logo on the BEYS website</li><li>Contributions of $100 or more receive field signage</li></ul></div></article>
<article class="modern-card gold-tier"><div class="modern-card-head"><p class="eyebrow">Team sponsorship</p><h3>Gold Team Sponsor</h3><strong>$300+</strong></div><div class="modern-card-body"><ul><li>Business name or logo on team jerseys</li><li>Select jersey color for your sponsored team</li><li>Website recognition</li><li>Field signage during fall and spring seasons</li><li>Exposure across local communities</li></ul><p class="fine-print">Team sponsorships are limited and first-come, first-served, subject to availability.</p></div></article>
</div><p class="fine-print packet-note">The updated 2027 sponsorship packet will be posted when available. <a href="/downloads/2026%20BEYS%20Sponsorship%20Opportunities.pdf" target="_blank" rel="noopener noreferrer">View the 2026 packet for reference (PDF).</a></p></div></section>
<section id="sponsor-form" class="modern-section modern-wrap"><div class="modern-heading"><p class="eyebrow">Join our community</p><h2>Become a BEYS partner.</h2><p>Submit your interest anytime and we will follow up with sponsorship details, payment options and logo information. Official 2027 sponsorships open January 1.</p></div>
        <form
            name="sponsor-interest"
            method="POST"
            data-netlify="true"
            class="contact-form"
        >

            <input type="hidden" name="form-name" value="sponsor-interest" />


            <!-- BUSINESS INFORMATION -->

            <label>
                Business Name *
                <input
                    type="text"
                    name="business-name"
                    required
                />
            </label>


            <label>
                Contact Person *
                <input
                    type="text"
                    name="contact-name"
                    required
                />
            </label>


            <label>
                Email *
                <input
                    type="email"
                    name="email"
                    required
                />
            </label>


            <label>
                Phone Number
                <input
                    type="tel"
                    name="phone"
                />
            </label>


            <label>
                Business Website or Social Media
                <input
                    type="text"
                    name="website"
                    placeholder="https://"
                />
            </label>


            <!-- SPONSORSHIP LEVEL -->

            <label>
                Sponsorship Level *

                <select
                    name="sponsorship-level"
                    required
                >

                    <option value="">
                        Select sponsorship level
                    </option>

                    <option value="Gold Team Sponsor ($300+)">
                        Gold Team Sponsor ($300+)
                    </option>

                    <option value="Blue Community Sponsor (Up to $299)">
                        Blue Community Sponsor (Up to $299)
                    </option>

                    <option value="General Donation">
                        General Donation
                    </option>

                </select>
            </label>


            <!-- TEAM SPONSORSHIP AVAILABILITY -->

            <div class="team-sponsorship-notice">

                <h3>⚽ Team Sponsorship Availability</h3>

                <p>
                    Team sponsorship opportunities are limited and available
                    on a first-come, first-served basis.
                </p>

                <p>2027 team availability will be confirmed by the board.</p>
</div>



            <!-- PREFERRED TEAM -->

            <label>
                Preferred Team

                <select name="preferred-team">

                    <option value="">
                        Select a team
                    </option>

                    <option value="U13">U13 (subject to availability)</option>
<option value="U10">U10 (subject to availability)</option>
<option value="U8">
                        U8
                    </option>

                    <option value="U6">
                        U6
                    </option>

                </select>
            </label>


            <!-- JERSEY COLOR -->

            <label>
                Preferred Jersey Color (Gold Sponsors)

                <input
                    type="text"
                    name="jersey-color"
                    placeholder="Example: Navy, Gold, White"
                />

            </label>


            <!-- LOGO -->

            <label class="checkbox-option">

                <input
                    type="checkbox"
                    name="logo-email"
                    value="Will email logo"
                />

                I will email my logo to BEYS

            </label>


            <!-- ADDITIONAL NOTES -->

            <label>
                Additional Notes

                <textarea
                    name="message"
                    rows="5"
                    placeholder="Anything else you would like us to know?"
                ></textarea>

            </label>


            <!-- SOURCE -->

            <input
                type="hidden"
                name="source"
                value="Website Sponsor Page"
            />


            <!-- SUBMIT -->

            <button
                type="submit"
                class="button"
            >
                Submit Sponsorship Interest
            </button>


        <p class="fine-print">Submitting this form does not commit you to a sponsorship or reserve a team. We will follow up to confirm availability and next steps.</p>
        </form>
</section>
<section class="modern-section soft-section"><div class="modern-wrap"><div class="modern-heading"><h2>Frequently asked questions.</h2></div>
<details class="modern-faq"><summary>Is my sponsorship tax deductible?</summary><p>BEYS is a 501(c)(3) nonprofit. Donations are tax deductible to the extent permitted by law.</p></details>
<details class="modern-faq"><summary>When is the sponsorship deadline?</summary><p>2027 jersey order deadlines will be announced once finalized.</p></details>
<details class="modern-faq"><summary>Can I sponsor more than one team?</summary><p>Yes! Additional support is always welcome, subject to team availability.</p></details>
<details class="modern-faq"><summary>How will my business be recognized?</summary><p>Recognition depends on your sponsorship level and may include website recognition, field signage and team jerseys.</p></details>
</div></section>
<section class="sponsor-spotlight">
    
        <!-- SECTION HEADING -->
        <div class="sponsor-heading">
            <span class="sponsor-eyebrow">Grateful for Our Community</span>
            <h2>Thank You to Our 2026 Sponsors!</h2>
            <p>
                Another wonderful year of BEYS soccer was made possible by the generosity of our local businesses, organizations and community supporters. Your support helps keep soccer affordable and creates opportunities for our young athletes. We are so grateful to have you on our team!
            </p>
        </div>
    
    
        <!-- =====================================================
             GOLD SPONSORS
             ===================================================== -->
    
        <div class="sponsor-tier">
    
            <div class="tier-heading">
                <span class="tier-label gold-label">2026 Gold Sponsors</span>
                <p>
                    Thank you to our Gold Sponsors for their generous support
                    of Bald Eagle Youth Soccer.
                </p>
            </div>
    
    
            <div class="sponsor-panel gold-panel">
    
                <!-- DEAD RIVER REMODELING -->
                <a href="https://www.facebook.com/profile.php?id=61558120787119"
                   class="sponsor-item"
                   target="_blank"
                   rel="noopener"
                   aria-label="Visit DeadRiver Remodeling & Construction LLC on Facebook">
    
                    <div class="sponsor-logo">
                        <img src="/readriver-removebg-preview.png"
                             alt="DeadRiver Remodeling & Construction LLC" style="max-height: 140px; max-width: 220px;">
                    </div>
    
                    <span class="sponsor-level">Gold Sponsor</span>
                    <h3>DeadRiver Remodeling &amp; Construction LLC</h3>
                    <span class="sponsor-visit">Visit Sponsor →</span>
    
                </a>
    
    
                <!-- GOURMET GRIDDLE CO -->
                <a href="https://www.facebook.com/profile.php?id=100091734101743"
                   class="sponsor-item"
                   target="_blank"
                   rel="noopener"
                   aria-label="Visit Gourmet Griddle Co on Facebook">
    
                    <div class="sponsor-logo">
                        <img src="/gourmetgriddlecompany.jpg"
                             alt="Gourmet Griddle Co">
                    </div>
    
                    <span class="sponsor-level">Gold Sponsor</span>
                    <h3>Gourmet Griddle Co</h3>
                    <span class="sponsor-visit">Visit Sponsor →</span>
    
                </a>
    
    
                <!-- THE JUNCTION 144 -->
                <a href="https://www.facebook.com/profile.php?id=100094147954680"
                   class="sponsor-item"
                   target="_blank"
                   rel="noopener"
                   aria-label="Visit The Junction 144 on Facebook">
    
                    <div class="sponsor-logo">
                        <img src="/junction144logo-removebg-preview.png"
                             alt="The Junction 144" style="max-height: 140px; max-width: 220px;">
                    </div>
    
                    <span class="sponsor-level">Gold Sponsor</span>
                    <h3>The Junction 144</h3>
                    <span class="sponsor-visit">Visit Sponsor →</span>
    
                </a>
    
    
                <!-- BIG D'S CONES & SHAKES -->
                <a href="https://www.facebook.com/profile.php?id=100057323864875"
                   class="sponsor-item"
                   target="_blank"
                   rel="noopener"
                   aria-label="Visit Big D's Cones & Shakes on Facebook">
    
                    <div class="sponsor-logo">
                        <img src="/bigd-removebg-preview.png"
                             alt="Big D's Cones & Shakes">
                    </div>
    
                    <span class="sponsor-level">Gold Sponsor</span>
                    <h3>Big D's Cones &amp; Shakes</h3>
                    <span class="sponsor-visit">Visit Sponsor →</span>
    
                </a>
    
    
                <!-- R & S CORL TRANSPORTATION -->
                <a href="https://www.stauffertransportation.com"
                   class="sponsor-item"
                   target="_blank"
                   rel="noopener"
                   aria-label="Visit R & S Corl Transportation">
    
                    <div class="sponsor-logo">
                        <img src="/rscorl.png"
                             alt="R & S Corl Transportation">
                    </div>
    
                    <span class="sponsor-level">Gold Sponsor</span>
                    <h3>R &amp; S Corl Transportation</h3>
                    <span class="sponsor-visit">Visit Sponsor →</span>
    
                </a>
    
    
                <!-- ANONYMOUS COMMUNITY SPONSOR -->
                <div class="sponsor-item">
    
                    <div class="sponsor-logo">
                        <img src="/beyslogo.png"
                             alt="Bald Eagle Youth Soccer">
                    </div>
    
                    <span class="sponsor-level">Gold Sponsor</span>
                    <h3>Anonymous Community Sponsor</h3>
    
                    <p>
                        Thank you to a generous community member who has chosen
                        to support BEYS anonymously.
                    </p>
    
                    <span class="sponsor-visit">
                        Thank You for Supporting BEYS 💙💛
                    </span>
    
                </div>
    
            </div>
    
        </div>
    
    
        <!-- =====================================================
             BLUE COMMUNITY SPONSORS
             ===================================================== -->
    
        <div class="sponsor-tier blue-community-tier">
    
            <div class="tier-heading">
                <span class="tier-label blue-label">2026 Blue Community Sponsors</span>
                <p>
                    We are grateful to the local organizations and businesses
                    that support youth soccer in our community.
                </p>
            </div>
    
    
            <div class="community-sponsor-panel">
    
                <!-- LOYAL ORDER OF MOOSE LODGE 1565 -->
                <div class="community-sponsor">
                    <div class="community-sponsor-icon">🦅</div>
                    <h3>Loyal Order of Moose Lodge 1565</h3>
                    <span>Blue Community Sponsor</span>
                </div>
    
    
                <!-- AMERICAN LEGION -->
                <div class="community-sponsor">
                    <div class="community-sponsor-icon">🦅</div>
                    <h3>American Legion Mumper Shawley Post</h3>
                    <span>Blue Community Sponsor</span>
                </div>
    
    
                <!-- NATURE'S COVER -->
                <div class="community-sponsor">
                    <div class="community-sponsor-icon">🦅</div>
                    <h3>Nature's Cover</h3>
                    <span>Blue Community Sponsor</span>
                </div>
    
            </div>
    
        </div>
    
    
        <!-- =====================================================
             SPONSOR CTA
             ===================================================== -->
    
        <div class="sponsor-footer">
            <p>
                Want to make a difference in our soccer community in 2027?
            </p>
    
            <a href="#sponsor-form" class="sponsor-btn">
                Become a 2027 BEYS Partner
            </a>
        </div>
    
    </section>
</Layout>
<style>
.sponsor-hero h1 span{color:var(--gold)}
.sponsor-hero p{max-width:650px}
.tier-grid{align-items:stretch!important}
.gold-tier .modern-card-head{background:var(--gold);color:var(--navy)}
.gold-tier .modern-card-head .eyebrow{color:var(--navy)}
.modern-card-head p{margin:0}
.modern-card-body li,.fact-panel li{margin-bottom:8px}
.packet-note{text-align:center;margin-top:24px}
#sponsor-form{scroll-margin-top:100px}
#sponsor-form .fact-panel{max-width:700px;margin:auto}
#sponsor-form .contact-form{margin-inline:auto}
</style>
<script>
if(Date.now() >= Date.parse('2027-01-01T00:00:00-05:00')){
 document.querySelectorAll('[data-sponsor-date]').forEach(el=>el.textContent='2027 sponsorships are open!');
}
</script>