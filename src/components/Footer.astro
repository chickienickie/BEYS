
---
const registrationUrl =
  'https://login.stacksports.com/login?client_id=612b0399b1854a002e427f78&redirect_uri=https://core-api.bluesombrero.com/login/redirect/portal/6317&app_name=Bald+Eagle+Youth+Soccer&portalid=6317&instancekey=sports';

const year = new Date().getFullYear();

const programs = [
  { label: 'Recreational Soccer', href: '/recreational' },
  { label: 'Travel Soccer', href: '/travel' },
  { label: 'Game Schedules', href: '/schedule' }
];

const resources = [
  { label: 'Fields & Directions', href: '/fields' },
  { label: 'Coach Resources', href: '/coach-resources' },
  { label: 'Food Truck Schedule', href: '/foodtrucks' },
  { label: 'Fundraisers', href: '/fundraisers' }
];

const community = [
  { label: 'About Us', href: '/board' },
  { label: 'Our Sponsors', href: '/sponsors/#2026-sponsors' },
  { label: 'Become a Sponsor', href: '/sponsors' },
  {
    label: 'Volunteer Opportunities',
    href: 'mailto:baldeagleyouthsoccer@gmail.com?subject=BEYS%20Volunteer%20Interest'
  }
];
---

<footer class="beys-footer">

  <div class="footer-wrap">

    <!-- Brand -->
    <div class="footer-brand">

      <a href="/" aria-label="Bald Eagle Youth Soccer Home">
        <img
          src="/beyslogo.png"
          alt="Bald Eagle Youth Soccer"
          width="80"
          height="80"
          loading="lazy"
        />
      </a>

      <div>
        <h2>Bald Eagle Youth Soccer</h2>

        <p class="footer-tagline">
          Building Skills. Building Confidence.
          Building Community.
        </p>

        <p class="footer-description">
          Proudly supporting youth soccer in
          the Bald Eagle Area.
        </p>
      </div>

    </div>

    <!-- Navigation and Contact -->
    <div class="footer-grid">

      <!-- Programs -->
      <div class="footer-group">

        <h3>Our Programs</h3>

        {programs.map(link => (
          <a href={link.href}>{link.label}</a>
        ))}

        <a
          href={registrationUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Register Now
        </a>

      </div>

      <!-- Resources -->
      <div class="footer-group">

        <h3>Resources</h3>

        {resources.map(link => (
          <a href={link.href}>{link.label}</a>
        ))}

      </div>

      <!-- Community -->
      <div class="footer-group">

        <h3>Our Community</h3>

        {community.map(link => (
          <a href={link.href}>{link.label}</a>
        ))}

      </div>

      <!-- Stay Connected -->
      <div class="footer-group">

        <h3>Stay Connected</h3>

        <a
          href="https://www.facebook.com/BaldEagleYouthSoccer"
          target="_blank"
          rel="noopener noreferrer"
        >
          <i class="fa-brands fa-facebook" aria-hidden="true"></i>
          Follow Us on Facebook
        </a>

        <a
          href="https://sportsyou.app"
          target="_blank"
          rel="noopener noreferrer"
        >
          <i class="fa-solid fa-mobile-screen" aria-hidden="true"></i>
          SportsYou App
        </a>

        <a href="mailto:baldeagleyouthsoccer@gmail.com">
          <i class="fa-solid fa-envelope" aria-hidden="true"></i>
          Email Us
        </a>

        <a
          class="footer-register"
          href={registrationUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Register →
        </a>

      </div>

      <!-- Contact -->
      <div class="footer-group footer-contact">

        <h3>Contact Us</h3>

        <address>
          Bald Eagle Youth Soccer<br />
          Unionville Soccer Fields<br />
          P.O. Box 704<br />
          Milesburg, PA 16853
        </address>

      </div>

    </div>

    <!-- Copyright -->
    <div class="footer-legal">

      <p>
        © <span data-footer-year>{year}</span>
        Bald Eagle Youth Soccer. All rights reserved.
      </p>

      <p>
        A volunteer-driven 501(c)(3) nonprofit organization.
      </p>

    </div>

  </div>

</footer>

<style>
  .beys-footer {
    background: #002a43;
    color: #fff;
    border-top: 4px solid #d5d49b;
    padding: 32px 0 20px;
    font-family: Inter, Arial, sans-serif;
  }

  .footer-wrap {
    width: min(1320px, 90%);
    margin: 0 auto;
  }

  /* Brand */

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(255,255,255,.18);
  }

  .footer-brand img {
    display: block;
    width: 80px;
    height: 80px;
    object-fit: contain;
  }

  .footer-brand h2 {
    color: #fff;
    font-family: Oswald, sans-serif;
    font-size: 1.8rem;
    text-transform: uppercase;
    margin: 0 0 6px;
  }

  .footer-tagline {
    color: #d5d49b;
    font-size: .85rem;
    font-weight: 600;
    margin: 0 0 6px;
  }

  .footer-description {
    color: #dbe4e9;
    font-size: .85rem;
    margin: 0;
  }

  /* Five-column navigation */

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 24px;
    padding: 28px 0;
  }

  .footer-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    min-width: 0;
  }

  .footer-group h3 {
    color: #d5d49b;
    font-family: Oswald, sans-serif;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: .04em;
    margin: 0 0 6px;
  }

  .beys-footer .footer-group a,
  .beys-footer .footer-group a:visited {
    color: #e7edf0;
    text-decoration: none;
    font-size: .85rem;
    line-height: 1.6;
    transition: color .2s ease;
  }

  .beys-footer .footer-group a:hover {
    color: #d5d49b;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .beys-footer a:focus-visible {
    outline: 2px solid #d5d49b;
    outline-offset: 4px;
    border-radius: 2px;
  }

  .footer-group i {
    color: #d5d49b;
    width: 18px;
    margin-right: 4px;
  }

  /* Registration button */

  .beys-footer .footer-group .footer-register,
  .beys-footer .footer-group .footer-register:visited {
    display: inline-flex;
    justify-content: center;
    background: #d5d49b;
    color: #002a43;
    border-radius: 4px;
    padding: 10px 18px;
    margin-top: 6px;
    font-size: .78rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .beys-footer .footer-group .footer-register:hover {
    background: #e4e3ba;
    color: #002a43;
    text-decoration: none;
  }

  /* Contact information */

  .footer-group address {
    color: #e7edf0;
    font-size: .85rem;
    font-style: normal;
    line-height: 1.8;
    margin: 0;
  }

  /* Copyright */

  .footer-legal {
    border-top: 1px solid rgba(255,255,255,.18);
    padding-top: 18px;
    text-align: center;
  }

  .footer-legal p {
    font-size: .75rem;
    color: #cbd7de;
    margin: 4px 0;
  }

  .footer-legal p:last-child {
    color: #d5d49b;
  }

  /* Tablet */

  @media (max-width: 1050px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px;
    }
  }

  /* Mobile */

  @media (max-width: 540px) {
    .beys-footer {
      padding-top: 24px;
    }

    .footer-brand {
      flex-direction: column;
      text-align: center;
      gap: 12px;
      padding-bottom: 20px;
    }

    .footer-brand img {
      width: 70px;
      height: 70px;
    }

    .footer-brand h2 {
      font-size: 1.5rem;
    }

    .footer-grid {
      gap: 24px 16px;
      padding: 24px 0;
    }

    .footer-group h3 {
      font-size: 1rem;
    }

    .footer-contact {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 340px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const footerYear = document.querySelector('[data-footer-year]');

  if (footerYear) {
    footerYear.textContent = String(new Date().getFullYear());
  }
</script>
