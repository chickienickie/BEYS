
---
const registrationOpens = "2027-01-01T00:00:00-05:00";
const registrationCloses = "2027-02-06T00:00:00-05:00";

const registrationUrl =
  "https://login.stacksports.com/login?client_id=612b0399b1854a002e427f78&redirect_uri=https://core-api.bluesombrero.com/login/redirect/portal/6317&app_name=Bald+Eagle+Youth+Soccer&portalid=6317&instancekey=sports";
---

<div
  class="alert-bar"
  data-opens={registrationOpens}
  data-closes={registrationCloses}
>
  <div class="announcement-inner">

    <a
      href={registrationUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-alert-registration
    >
      Spring 2027 Registration • Jan 1–Feb 5 • Rec &amp; Travel →
    </a>

    <span class="announcement-divider" aria-hidden="true">|</span>

    <a href="/sponsors" data-alert-sponsor>
      2027 Business Sponsorships Open January 1 →
    </a>

  </div>
</div>

<style>
  .alert-bar {
    background: #d5d49b;
    color: #002a43;
    padding: 10px 20px;
    white-space: normal;
    font-family: "Inter", sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .announcement-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px 16px;
    max-width: 1400px;
    margin: 0 auto;
    text-align: center;
  }

  .announcement-divider {
    opacity: 0.4;
  }

  .alert-bar a,
  .alert-bar a:visited {
    color: #002a43;
    font-weight: 700;
    text-decoration: none;
  }

  .alert-bar a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .alert-bar a:focus-visible {
    outline: 2px solid #002a43;
    outline-offset: 4px;
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    .alert-bar {
      padding: 10px 15px;
      font-size: 0.65rem;
    }

    .announcement-inner {
      flex-direction: column;
      gap: 4px;
    }

    .announcement-divider {
      display: none;
    }
  }
</style>

<script>
  function updateAnnouncement() {
    const bar = document.querySelector<HTMLElement>(
      ".alert-bar[data-opens]"
    );

    if (!bar?.dataset.opens || !bar.dataset.closes) return;

    const openingDate = Date.parse(bar.dataset.opens);
    const closingDate = Date.parse(bar.dataset.closes);
    const now = Date.now();

    const registration = bar.querySelector<HTMLAnchorElement>(
      "[data-alert-registration]"
    );

    const sponsorship = bar.querySelector(
      "[data-alert-sponsor]"
    );

    if (registration) {
      if (now >= closingDate) {
        registration.textContent =
          "Spring 2027 Registration Is Closed";

        registration.removeAttribute("href");
        registration.removeAttribute("target");
        registration.removeAttribute("rel");

      } else if (now >= openingDate) {
        registration.textContent =
          "Rec & Travel Registration Open Through Feb 5 →";
      }
    }

    if (sponsorship && now >= openingDate) {
      sponsorship.textContent =
        "2027 Business Sponsorships Are Open →";
    }
  }

  updateAnnouncement();

  document.addEventListener(
    "astro:page-load",
    updateAnnouncement
  );
</script>
